NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Room state lives in the Supabase `rooms` table (see supabase/migrations)
# whenever NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are both
# set. Without them, rooms fall back to server memory for local dev only.

# Shared secret that authorizes the daily room-cleanup cron
# (app/api/cron/cleanup-rooms). Vercel sends this automatically as
# `Authorization: Bearer $CRON_SECRET` once the env var is set on the
# project — generate one with `openssl rand -hex 32`.
CRON_SECRET=your-cron-secret

# Enable Anonymous sign-ins in the Supabase dashboard:
# Authentication → Providers → Anonymous

# Without this, rounds fall back to the deterministic template-fill composer.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional overrides — default to claude-opus-5 for all three:
# AI_COMPOSER_MODEL=claude-opus-5
# AI_JUDGE_MODEL=claude-opus-5
# AI_PROMPT_MODEL=claude-opus-5
