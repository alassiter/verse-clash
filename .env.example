NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Enable Anonymous sign-ins in the Supabase dashboard:
# Authentication → Providers → Anonymous

# Without this, rounds fall back to the deterministic template-fill composer.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional overrides — default to claude-opus-5 for all three:
# AI_COMPOSER_MODEL=claude-opus-5
# AI_JUDGE_MODEL=claude-opus-5
# AI_PROMPT_MODEL=claude-opus-5
